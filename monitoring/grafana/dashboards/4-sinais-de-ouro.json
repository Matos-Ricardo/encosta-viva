{
  "title": "Encosta Viva - 4 sinais de ouro",
  "uid": "encosta-4-sinais",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1. Latência p95 (segundos)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_highr_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2. Tráfego (requisições/min e leituras do sensor/min)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "requisições/min {{job}}",
          "expr": "sum by (job) (rate(http_requests_total[1m])) * 60"
        },
        {
          "refId": "B",
          "legendFormat": "leituras/min {{job}}",
          "expr": "sum by (job) (rate(leituras_total[1m])) * 60"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "3. Erros (taxa de respostas 5xx)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "5xx {{job}}",
          "expr": "(sum by (job) (rate(http_requests_total{status=\"5xx\"}[5m])) or sum by (job) (rate(http_requests_total[5m])) * 0) / sum by (job) (rate(http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4. Saturação (CPU em cores e memória)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "CPU (cores) {{job}}",
          "expr": "rate(process_cpu_seconds_total[1m])"
        },
        {
          "refId": "B",
          "legendFormat": "memória (bytes) {{job}}",
          "expr": "process_resident_memory_bytes"
        }
      ]
    }
  ]
}
